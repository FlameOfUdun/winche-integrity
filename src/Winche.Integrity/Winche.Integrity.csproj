<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Winche.Integrity</PackageId>
    <RootNamespace>Winche.Integrity</RootNamespace>
    <PackageDescription>Winche Integrity: a project's apps prove they're its own (debug tokens; App Attest, Play Integrity and a browser check to come) and get short-lived tokens; each product checks them, counts them, and can refuse requests without one.</PackageDescription>
    <PackageTags>attestation;app-integrity;security</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Winche.Integrity.Tests" />
    <InternalsVisibleTo Include="Winche.Integrity.AspNetCore" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
    <PackageReference Include="Winche.Core" Version="2.0.0" />
  </ItemGroup>
</Project>
